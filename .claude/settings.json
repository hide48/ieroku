{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Bash(cat .env*)",
      "Bash(cat .dev.vars*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpx:*)",
      "Bash(npx:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm shadcn:*)",
      "Bash(pnpm exec shadcn:*)",
      "Bash(wrangler deploy:*)",
      "Bash(pnpm wrangler deploy:*)",
      "Bash(pnpm exec wrangler deploy:*)",
      "Bash(pnpm deploy:*)",
      "Bash(pnpm run deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(pnpm wrangler secret:*)",
      "Bash(pnpm exec wrangler secret:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ]
  }
}

